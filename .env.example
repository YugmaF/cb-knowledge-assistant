# Copy to .env and fill in. Never commit .env.

# LLM (OpenRouter by default; any OpenAI-compatible endpoint works via LLM_BASE_URL)
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Per-stage model overrides, e.g.:
# MODELS__RESPONSE=anthropic/claude-sonnet-5
# MODELS__FALLBACK=google/gemini-2.5-flash

# Pinecone (optional: without a key the in-process local store is used)
PINECONE_API_KEY=
PINECONE_INDEX=cb-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cb-knowledge-assistant

# Security: the API refuses to start without a real secret (>= 32 bytes, not a placeholder).
# ./run.sh generates a random one for each run when this is unset or still the placeholder.
# For Docker Compose set it here:  JWT_SECRET=$(openssl rand -hex 32)
JWT_SECRET=REPLACE_ME_run__openssl_rand_-hex_32

# Rate limits per role (token bucket), e.g.:
# RATE_LIMITS__VIEWER__CAPACITY=5
# RATE_LIMITS__VIEWER__REFILL_PER_MINUTE=10
